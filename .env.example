# Imagen pública estable y metadatos de compilación local.
VG_IMAGE=ghcr.io/ezr43l/vault-guardian-s:1.0.18
VG_BUILD_VERSION=1.0.18
VG_SOURCE_URL=https://github.com/Ezr43l/vault-guardian-s
VG_LICENSE_SPDX=Apache-2.0
VG_CONTAINER_NAME=vault-guardian

# Único estado persistente: configuración, cuentas, historial, backups y
# secretos generados por la aplicación.
VG_STATE_PATH=./local-data/state

# Raíz host que contiene los bind mounts /data de las instancias Vaultwarden.
# Docker debe montarla al crear Guardian; no puede cambiarse desde el portal.
VG_DATA_PATH=/srv/docker/appdata

# Publicación del portal. 127.0.0.1 presupone un proxy HTTPS local.
VG_BIND_ADDRESS=127.0.0.1
VG_HOST_PORT=6062
